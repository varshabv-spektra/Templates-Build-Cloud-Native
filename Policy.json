{
  "if": {
    "anyOf": [
      {
        "not": {
          "anyOf": [
            {
              "field": "type",
              "like": "Microsoft.HorizonDB/*"
            },
            {
              "field": "type",
              "like": "Microsoft.CognitiveServices/accounts/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Search/searchServices/*"
            },
            {
              "field": "type",
              "like": "Microsoft.Storage/storageAccounts/*"
            },
            {
              "field": "type",
              "like": "Microsoft.ContainerInstance/containerGroups/*"
            },
            {
              "field": "type",
              "in": [
                "Microsoft.CognitiveServices/accounts",
                "Microsoft.Search/searchServices",
                "Microsoft.Storage/storageAccounts",
                "Microsoft.ManagedIdentity/userAssignedIdentities",
                "Microsoft.Resources/deploymentScripts",
                "Microsoft.ContainerInstance/containerGroups",
                "Microsoft.Authorization/roleAssignments"
              ]
            }
          ]
        }
      },
      {
        "allOf": [
          {
            "field": "location",
            "exists": "true"
          },
          {
            "not": {
              "field": "location",
              "in": [
                "eastus",
                "centralus",
                "global"
              ]
            }
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.CognitiveServices/accounts"
          },
          {
            "anyOf": [
              {
                "not": {
                  "field": "Microsoft.CognitiveServices/accounts/sku.name",
                  "in": [
                    "S0"
                  ]
                }
              },
              {
                "not": {
                  "field": "kind",
                  "in": [
                    "OpenAI",
                    "AIServices"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.CognitiveServices/accounts/deployments"
          },
          {
            "anyOf": [
              {
                "not": {
                  "field": "Microsoft.CognitiveServices/accounts/deployments/model.name",
                  "in": [
                    "gpt-5.4",
                    "text-embedding-3-small",
                    "text-embedding-3-large"
                  ]
                }
              },
              {
                "not": {
                  "field": "Microsoft.CognitiveServices/accounts/deployments/sku.name",
                  "in": [
                    "GlobalStandard",
                    "Standard"
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Search/searchServices"
          },
          {
            "not": {
              "field": "Microsoft.Search/searchServices/sku.name",
              "in": [
                "basic",
                "standard"
              ]
            }
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Storage/storageAccounts"
          },
          {
            "not": {
              "field": "Microsoft.Storage/storageAccounts/sku.name",
              "in": [
                "Standard_LRS"
              ]
            }
          }
        ]
      }
    ]
  },
  "then": {
    "effect": "deny"
  }
}
